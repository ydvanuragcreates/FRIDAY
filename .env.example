# Anthropic API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Optional: override the default model
ANTHROPIC_MODEL=claude-opus-5

# Directory the agent's tools (list_files, read_file, search_code,
# create_file, write_file, run_command, run_tests) are allowed to access.
# Tools cannot read, list, write, or run commands outside this directory —
# defaults to the current working directory.
WORKSPACE_ROOT=.

# Command the run_tests tool executes.
TEST_COMMAND=pytest

# Comma-separated allowlist of executables run_command/run_tests may
# invoke. Anything not listed is rejected — keep this to test/build/
# inspection tools, never anything destructive (see README > Command
# safety for why).
ALLOWED_COMMANDS=pytest,python,python3,npm,node,yarn,pnpm,go,cargo,make

# Wall-clock ceiling, in seconds, for any single validated command.
COMMAND_TIMEOUT_SECONDS=30

# How many times the fix-and-retest loop may retry after a failing test
# before giving up and reporting failure instead of looping forever.
MAX_RETRIES=3

# Voyage AI API key — required to actually index a repo or run semantic
# search (POST /api/projects/{project_id}/index, the semantic_code_search
# tool). Not required just to run the server or use /api/chat /api/tasks
# for requests that don't need search. Get one at https://www.voyageai.com/
VOYAGE_API_KEY=

# Embedding model — voyage-code-3 is trained specifically for code retrieval.
EMBEDDING_MODEL=voyage-code-3

# Qdrant connection. Leave QDRANT_URL unset to run Qdrant embedded, on
# disk at QDRANT_PATH — no server required. Set QDRANT_URL (e.g. a Qdrant
# Cloud endpoint) to use a real deployment instead.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=.qdrant_data

# The project the LangGraph agent's semantic_code_search tool searches
# (see README > "Project scope"). Index into this project_id for the
# agent to find it automatically.
DEFAULT_PROJECT_ID=default

# PostgreSQL, via SQLAlchemy's async engine + asyncpg. Format:
# postgresql+asyncpg://user:password@host:port/database
# Never commit real credentials — this file only holds placeholders.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_coding_agent

# Echo every SQL statement to stdout — useful for debugging, noisy otherwise.
DATABASE_ECHO=false
